{
  "$schema": "../../schemas/theme.schema.json",
  "id": "ds.standard.movie",
  "name": "Sinema",
  "version": "1.0.0",
  "author": "Inlay Disc Studio",
  "description": "Tam ekran sahne, sol altta başlık; film, dizi ve film koleksiyonları için.",
  "license": "MIT",
  "modes": [
    "movie",
    "mixed"
  ],
  "engine": "liquid",
  "entry": "index.liquid",
  "partials": [
    "partials/views.liquid",
    "partials/menu.liquid",
    "partials/collection.liquid",
    "partials/movie.liquid",
    "partials/series.liquid",
    "partials/album.liquid",
    "partials/gallery.liquid",
    "partials/app.liquid",
    "partials/bundle.liquid",
    "partials/file.liquid",
    "partials/card.liquid",
    "partials/top.liquid",
    "partials/about.liquid",
    "partials/icons.liquid"
  ],
  "minLauncher": "0.1.0",
  "capabilities": [
    "play",
    "playlist",
    "slideshow",
    "run",
    "install",
    "openFolder",
    "url",
    "gamepad",
    "intro",
    "fullscreen"
  ],
  "fonts": [
    {
      "family": "Outfit",
      "file": "fonts/Outfit-latin.woff2",
      "weight": "100 900"
    },
    {
      "family": "Outfit",
      "file": "fonts/Outfit-latin-ext.woff2",
      "weight": "100 900"
    }
  ],
  "settings": {
    "variant": {
      "type": "select",
      "label": "Düzen",
      "group": "Yerleşim",
      "default": "cinema",
      "options": [
        {
          "value": "cinema",
          "label": "Sinema"
        },
        {
          "value": "plain",
          "label": "Sade"
        }
      ]
    },
    "primary": {
      "type": "select",
      "label": "Birincil buton",
      "group": "Renk",
      "default": "cream",
      "options": [
        {
          "value": "cream",
          "label": "Krem"
        },
        {
          "value": "amber",
          "label": "Kehribar"
        },
        {
          "value": "ice",
          "label": "Buz mavisi"
        }
      ]
    },
    "showCast": {
      "type": "bool",
      "label": "Oyuncuları göster",
      "group": "Yerleşim",
      "default": true
    }
  },
  "budget": {
    "maxAssetsMb": 4,
    "maxFirstPaintMs": 800
  }
}
