{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discstudio.local/schemas/theme.v1.json",
  "title": "Disc Studio Theme Package v1",
  "description": "Bir .disctheme (zip) paketinin kökündeki theme.json. Standart şablonlar da kullanıcı şablonları da aynı sözleşmeyi kullanır.",
  "type": "object",
  "required": ["id", "name", "version", "modes", "entry", "engine", "minLauncher"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "Ters-domain benzeri benzersiz id. Standartlar: ds.standard.*"
    },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "license": { "type": "string" },
    "preview": { "type": "string", "description": "Paket içi göreli yol: galeri küçük resmi (16:9 WebP)." },

    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["mixed", "movie", "album", "gallery", "app"] },
      "description": "Şablonun düzgün çalıştığı disk modları. mixed = 'Hepsi' menüsü."
    },

    "engine": {
      "enum": ["liquid", "static"],
      "description": "liquid: Fluid ile yakma anında render edilir; static: HTML olduğu gibi kopyalanır, veri JS ile manifest.json'dan okunur."
    },
    "entry": { "type": "string", "default": "index.liquid" },
    "partials": {
      "type": "array",
      "description": "{% render %} ile kullanılabilecek parçalar.",
      "items": { "type": "string" }
    },
    "minLauncher": { "type": "string", "description": "Gerekli en düşük launcher/SDK sürümü (semver)." },

    "capabilities": {
      "type": "array",
      "description": "Şablonun kullandığı SDK yetenekleri; builder lint aşamasında kontrol eder.",
      "uniqueItems": true,
      "items": {
        "enum": ["play", "playlist", "slideshow", "run", "install", "openFolder", "url", "gamepad", "intro", "fullscreen"]
      }
    },

    "fonts": {
      "type": "array",
      "description": "Pakete gömülü fontlar (diske kopyalanır; internetten font yüklemek yasak).",
      "items": {
        "type": "object",
        "required": ["family", "file"],
        "additionalProperties": false,
        "properties": {
          "family": { "type": "string" },
          "file": { "type": "string" },
          "weight": { "type": "string" },
          "style": { "enum": ["normal", "italic"] }
        }
      }
    },

    "settings": {
      "type": "object",
      "description": "Editörün kod gerektirmeyen 'Ayarlar' panelini otomatik üreten tanımlar. Şablonda {{ settings.<key> }} ile, CSS'te var(--ds-<key>) ile erişilir.",
      "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,39}$" },
      "additionalProperties": { "$ref": "#/$defs/setting" }
    },

    "sections": {
      "type": "object",
      "description": "mixed modunda bölüm türlerine göre varsayılan yerleşim.",
      "additionalProperties": false,
      "properties": {
        "movie": { "$ref": "#/$defs/sectionDefault" },
        "album": { "$ref": "#/$defs/sectionDefault" },
        "gallery": { "$ref": "#/$defs/sectionDefault" },
        "app": { "$ref": "#/$defs/sectionDefault" },
        "file": { "$ref": "#/$defs/sectionDefault" }
      }
    },

    "budget": {
      "type": "object",
      "description": "Lint uyarı eşikleri.",
      "additionalProperties": false,
      "properties": {
        "maxAssetsMb": { "type": "number", "default": 15 },
        "maxFirstPaintMs": { "type": "integer", "default": 800 }
      }
    }
  },

  "$defs": {
    "sectionDefault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": { "enum": ["row", "grid", "hero", "list"] },
        "title": { "type": "string" }
      }
    },
    "setting": {
      "type": "object",
      "required": ["type", "label"],
      "properties": {
        "type": { "enum": ["color", "bool", "font", "select", "range", "image", "text"] },
        "label": { "type": "string" },
        "help": { "type": "string" },
        "group": { "type": "string", "description": "Ayarlar panelinde gruplama başlığı." },
        "default": {}
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "color" } } },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "pattern": "^(auto|auto:(bg|surface|accent|text|muted)|#[0-9a-fA-F]{6})$"
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "bool" } } },
          "then": { "properties": { "default": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "type": { "const": "select" } } },
          "then": {
            "required": ["options"],
            "properties": {
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["value", "label"],
                  "properties": { "value": { "type": "string" }, "label": { "type": "string" } }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "range" } } },
          "then": {
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" },
              "step": { "type": "number" },
              "unit": { "type": "string" },
              "default": { "type": "number" }
            }
          }
        }
      ]
    }
  }
}
